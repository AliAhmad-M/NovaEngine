{
  "name": "star-platinum-engine",
  "version": "1.0.0",
  "dependencies": [
    {
      "name": "glad",
      "features": [
        "loader"
      ]
    },
    "glfw3",
    "glm",
    "stb",
    {
      "name": "freetype",
      "features": [
        "brotli",
        "bzip2",
        "png",
        "zlib"
      ]
    },
    "openal-soft",
    "joltphysics",
    "nlohmann-json",
    "box2d",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "opengl3-binding",
        "docking-experimental"
      ]
    },
    "imguizmo"
  ]
}